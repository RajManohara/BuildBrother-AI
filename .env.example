# Run python scripts/setup_local.py to generate local-only credentials.
POSTGRES_DB=buildbrother
POSTGRES_USER=buildbrother
POSTGRES_PASSWORD=replace-with-local-password
# SQLite is the zero-install local demo. Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./buildbrother.db
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_URL=http://127.0.0.1:8000
APP_API_KEY=replace-with-app-key
INGEST_TOKEN=replace-with-ingest-token
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
# Use a quoted PEM value with literal \n between lines. Never commit the key.
GITHUB_PRIVATE_KEY=
GITHUB_REPOSITORY=RajManohara/BuildBrother-AI
GITHUB_API_VERSION=2026-03-10
COLLECTOR_INTERVAL_SECONDS=300
